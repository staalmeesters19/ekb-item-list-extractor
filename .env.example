# EKB ProCos Matcher — environment template.
#
# Kopieer dit bestand naar `.env` en vul de waarden in.
# `.env` staat in .gitignore en wordt NOOIT gecommit.

# =============================================================================
# Auth — verplicht
# =============================================================================
# Lange random-string. Wordt door LibreChat als Bearer-token gestuurd.
# Genereer met: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGYLE_API_KEY=change-me-to-a-long-random-string

# =============================================================================
# Publieke URL — waar de service voor gebruikers bereikbaar is
# =============================================================================
# Gebruikt om absolute download-links te bouwen in chat-replies.
# In EKB-context: interne DNS-naam of IP + poort.
PUBLIC_URL=http://localhost:8080

# =============================================================================
# Data-volumes — host-paden die de container mount
# =============================================================================
# Directory met de 4 ProCos-referentiebestanden.
# Zie DEPLOY.md § 3 voor de exacte bestandsnamen.
PROCOS_DATA_HOST=./procos-data-host

# Directory waar de service feedback.jsonl schrijft.
# Moet persistent zijn — container-restarts mogen data niet wegvegen.
FEEDBACK_HOST=./feedback-host
